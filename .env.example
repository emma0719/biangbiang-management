DB_URL=jdbc:mysql://localhost:3306/restaurant_ops
DB_USERNAME=restaurant_ops
DB_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-signing-secret
TOAST_PIN_ENCRYPTION_KEY=replace-with-a-separate-long-random-encryption-key
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
PROFILE_PHOTO_STORAGE_DIR=./work/profile-photos
